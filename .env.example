# ═══════════════════════════════════════════════════════════════════
# QR DOMOTIK — Variables d'environnement
# ═══════════════════════════════════════════════════════════════════

# ─── Base de données ──────────────────────────────────────────────────
# SQLite (par défaut, fichier dans le container)
DATABASE_URL=file:/app/data/qrdomotik.db

# ─── NextAuth ─────────────────────────────────────────────────────────
# OBLIGATOIRE : généré avec `openssl rand -base64 32`
NEXTAUTH_SECRET=votre_secret_ici_generer_avec_openssl
# URL publique de votre app (ex: https://qrdomotik.votre-domaine.com)
NEXTAUTH_URL=https://qrdomotik.votre-domaine.com

# ─── Application ─────────────────────────────────────────────────────
# Port interne (Coolify gère le port externe via Nginx)
PORT=3000
NODE_ENV=production