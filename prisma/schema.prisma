// ═══════════════════════════════════════════════════════════════════════════════
// QR DOMOTIK V3 — Schéma de Base de Données Complet
// Plateforme SaaS de Maison Phygital + Marketplace de Quartier
// ═══════════════════════════════════════════════════════════════════════════════
//
// STACK : SQLite + Prisma ORM
// RLS   : Émulé au niveau applicatif via checkMembership() sur chaque API
// IDs   : CUID (String) au lieu d'UUID natif PostgreSQL
// GEO   : lat/lng Float + Haversine (pas de PostGIS en SQLite)
// JSON  : String JSON (pas de JSONB natif)
//
// TABLES V1  (9)  : User, Home, HomeMember, Room, QrCode, QrContent,
//                   ActivityLog, Product, ProductInstance
// TABLES V2  (6)  : Chore, ChoreCompletion, Invitation, GuestbookEntry,
//                   PushSubscription, Notification
// TABLES V3  (11) : Merchant, Promo, PromoRedemption, ScrapingJob,
//                   Professional, Service, ServiceRequest, Review,
//                   EmergencyQrCode, Subscription, Transaction
// TABLES V4  (3)  : QrBatch, PhysicalQrCode, ActivationLog
//
// TOTAL : 29 tables
//
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Configuration ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 1 : USERS — Utilisateurs de la plateforme
// ═══════════════════════════════════════════════════════════════════════════════
// Un utilisateur peut être propriétaire, commerçant, artisan, ou consommateur.
// V3: Ajout des relations merchants, professionalProfile, reviews, transactions.

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  passwordHash String  @map("password_hash")
  fullName    String   @map("full_name")
  role        String   @default("user") @map("role")       // V4: 'user' | 'superadmin'
  avatarUrl   String?  @map("avatar_url")
  avatarColor String?  @map("avatar_color")
  phone       String?                                // V3: téléphone pour artisans/commerçants
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // ─── Relations V1/V2 ───
  ownedHomes         Home[]              @relation("HomeOwner")
  memberships        HomeMember[]
  activityLogs       ActivityLog[]
  choreCompletions   ChoreCompletion[]   @relation("ChildCompletions")
  validatedChores    ChoreCompletion[]   @relation("ValidatorCompletions")
  assignedChores     Chore[]             @relation("ChoreAssignee")
  sentInvitations    Invitation[]        @relation("Inviter")
  pushSubscriptions  PushSubscription[]
  notifications      Notification[]

  // ─── Relations V3 ───
  merchantProfile    Merchant?           @relation("MerchantUser")
  professionalProfile Professional?       @relation("ProfessionalUser")
  writtenReviews     Review[]
  promoRedemptions   PromoRedemption[]
  transactions       Transaction[]       @relation("TransactionPayer")
  receivedTransactions Transaction[]     @relation("TransactionReceiver")

  // ─── Relations V4 (QR Physiques) ───
  createdBatches      QrBatch[]
  activatedQrCodes    PhysicalQrCode[]   @relation("Activator")
  activationLogs      ActivationLog[]

  @@map("users")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 2 : HOMES — Maisons / Foyers
// ═══════════════════════════════════════════════════════════════════════════════
// V3: Ajout de latitude/longitude pour le matching géolocalisé des promos.

model Home {
  id          String   @id @default(cuid())
  ownerId     String   @map("owner_id")
  name        String
  address     String?
  timezone    String   @default("Europe/Paris")
  latitude    Float?                               // V3: pour matching promos quartier
  longitude   Float?                               // V3: pour matching promos quartier
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // ─── Relations ───
  owner         User              @relation("HomeOwner", fields: [ownerId], references: [id])
  members       HomeMember[]
  rooms         Room[]
  qrCodes       QrCode[]
  activityLogs  ActivityLog[]
  products      Product[]
  chores        Chore[]
  invitations       Invitation[]
  notifications      Notification[]
  serviceRequests    ServiceRequest[]

  @@map("homes")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 3 : HOME_MEMBERS — Membres d'un foyer (V2)
// ═══════════════════════════════════════════════════════════════════════════════

model HomeMember {
  id        String    @id @default(cuid())
  homeId    String    @map("home_id")
  userId    String    @map("user_id")
  role      String    @default("member") // 'owner' | 'admin' | 'member' | 'child'
  nickname  String?
  points    Int       @default(0)
  invitedAt DateTime? @map("invited_at")
  joinedAt  DateTime? @map("joined_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([homeId, userId])
  @@index([homeId])
  @@index([userId])
  @@map("home_members")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 4 : ROOMS — Pièces de la maison
// ═══════════════════════════════════════════════════════════════════════════════

model Room {
  id        String   @id @default(cuid())
  homeId    String   @map("home_id")
  name      String
  icon      String   @default("square")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  home    Home      @relation(fields: [homeId], references: [id], onDelete: Cascade)
  qrCodes QrCode[]

  @@index([homeId])
  @@map("rooms")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 5 : QR_CODES — Codes QR dynamiques
// ═══════════════════════════════════════════════════════════════════════════════
// V3: Ajout du type 'emergency_service' pour les QR codes d'urgence artisan.

model QrCode {
  id            String   @id @default(cuid())
  homeId        String   @map("home_id")
  roomId        String?  @map("room_id")
  name          String
  type          String   // Voir QrType dans types/index.ts
  publicSlug    String   @unique @map("public_slug")
  isActive      Boolean  @default(true) @map("is_active")
  isPrivate     Boolean  @default(false) @map("is_private")
  pinCode       String?  @map("pin_code")
  isPresentMode Boolean  @default(true) @map("is_present_mode")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  home            Home            @relation(fields: [homeId], references: [id], onDelete: Cascade)
  room            Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  content         QrContent?
  activityLogs    ActivityLog[]
  guestbookEntries GuestbookEntry[]
  serviceRequests  ServiceRequest[]
  emergencyConfig  EmergencyQrCode?
  physicalActivations PhysicalQrCode[] @relation("LinkedQrCode")

  @@index([homeId])
  @@index([publicSlug])
  @@index([type])
  @@map("qr_codes")
}

/*
  ┌──────────────────────────────────────────────────────────────────┐
  │  TYPES DE QR CODES (QrType) — V1 + V2 + V3                      │
  ├──────────────────────────────────────────────────────────────────┤
  │  V1:                                                            │
  │  "wifi"          → Connexion Wi-Fi                              │
  │  "link"          → Lien externe                                  │
  │  "info"          → Guide maison                                 │
  │  "postit"        → Post-it numérique                             │
  │  "shopping_list" → Liste de courses collaborative               │
  │  "doorman"       → Portier virtuel                              │
  │  "medication"    → Suivi médicaments                            │
  │  "chores"        → Corvées enfants gamifiées                    │
  │  "stock_dlc"     → Gestion stock & DLC                          │
  │                                                                  │
  │  V2:                                                            │
  │  "guestbook"      → Livre d'or                                  │
  │  "energy_counter" → Compteur d'énergie                          │
  │  "keys_tracker"   → Suivi des clés                              │
  │  "daily_menu"     → Menu du jour                                │
  │                                                                  │
  │  V3 (ajouts):                                                    │
  │  "emergency_service" → QR code d'urgence artisan               │
  │  "neighborhood"      → QR code quartier (carte commerces)      │
  └──────────────────────────────────────────────────────────────────┘
*/

// ═══════════════════════════════════════════════════════════════════
// TABLE 6 : QR_CONTENTS — Contenu dynamique de chaque QR code
// ═══════════════════════════════════════════════════════════════════

model QrContent {
  id          String   @id @default(cuid())
  qrCodeId    String   @unique @map("qr_code_id")
  contentJson String   @map("content_json")
  updatedAt   DateTime @updatedAt @map("updated_at")

  qrCode QrCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@map("qr_contents")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 7 : ACTIVITY_LOGS — Journal d'activité global
// ═══════════════════════════════════════════════════════════════════════════════

model ActivityLog {
  id          String   @id @default(cuid())
  homeId      String   @map("home_id")
  qrCodeId    String?  @map("qr_code_id")
  userId      String?  @map("user_id")
  actionType  String   @map("action_type")
  detailsJson String?  @map("details_json")
  visitorName String?  @map("visitor_name")
  createdAt   DateTime @default(now()) @map("created_at")

  home    Home    @relation(fields: [homeId], references: [id], onDelete: Cascade)
  qrCode  QrCode? @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([homeId])
  @@index([qrCodeId])
  @@index([userId])
  @@index([actionType])
  @@index([createdAt])
  @@map("activity_logs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 8 : PRODUCTS — Produits pour le module Stock & DLC
// ═══════════════════════════════════════════════════════════════════════════════

model Product {
  id                 String   @id @default(cuid())
  homeId             String   @map("home_id")
  name               String
  category           String   @default("autre")
  minStockThreshold  Int      @default(1) @map("min_stock_threshold")
  currentStock       Int      @default(0) @map("current_stock")
  isOnShoppingList   Boolean  @default(false) @map("is_on_shopping_list")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  home             Home              @relation(fields: [homeId], references: [id], onDelete: Cascade)
  productInstances ProductInstance[]

  @@index([homeId])
  @@map("products")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 9 : PRODUCT_INSTANCES — Instances de produits
// ═══════════════════════════════════════════════════════════════════════════════

model ProductInstance {
  id           String    @id @default(cuid())
  productId    String    @map("product_id")
  homeId       String    @map("home_id")
  purchaseDate DateTime? @map("purchase_date")
  expiryDate   DateTime  @map("expiry_date")
  status       String    @default("fresh")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([homeId])
  @@index([expiryDate])
  @@index([status])
  @@map("product_instances")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 10 : CHORES — Corvées enfants (V2)
// ═══════════════════════════════════════════════════════════════════════════════

model Chore {
  id                String   @id @default(cuid())
  homeId            String   @map("home_id")
  title             String
  description       String?
  pointsValue       Int      @default(10) @map("points_value")
  frequency         String   @default("once")
  assignedToUserId  String?  @map("assigned_to_user_id")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  home              Home              @relation(fields: [homeId], references: [id], onDelete: Cascade)
  assignedToUser    User?             @relation("ChoreAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  completions       ChoreCompletion[]

  @@index([homeId])
  @@index([assignedToUserId])
  @@map("chores")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 11 : CHORE_COMPLETIONS — Validations de corvées (V2)
// ═══════════════════════════════════════════════════════════════════════════════

model ChoreCompletion {
  id               String    @id @default(cuid())
  choreId          String    @map("chore_id")
  childUserId      String    @map("child_user_id")
  validatedByUserId String?  @map("validated_by_user_id")
  pointsEarned     Int       @default(0) @map("points_earned")
  completedAt      DateTime  @default(now()) @map("completed_at")
  validatedAt      DateTime? @map("validated_at")
  status           String    @default("pending_validation")
  createdAt        DateTime  @default(now()) @map("created_at")

  chore          Chore            @relation(fields: [choreId], references: [id], onDelete: Cascade)
  childUser      User             @relation("ChildCompletions", fields: [childUserId], references: [id], onDelete: Cascade)
  validatedByUser User?           @relation("ValidatorCompletions", fields: [validatedByUserId], references: [id], onDelete: SetNull)

  @@index([choreId])
  @@index([childUserId])
  @@index([status])
  @@map("chore_completions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 12 : INVITATIONS — Invitations de membres (V2)
// ═══════════════════════════════════════════════════════════════════════════════

model Invitation {
  id         String   @id @default(cuid())
  homeId     String   @map("home_id")
  inviterId  String   @map("inviter_id")
  email      String
  role       String   @default("member")
  token      String   @unique
  status     String   @default("pending")
  nickname   String?
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  home    Home   @relation(fields: [homeId], references: [id], onDelete: Cascade)
  inviter User   @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([homeId])
  @@index([email])
  @@index([token])
  @@index([status])
  @@map("invitations")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 13 : GUESTBOOK_ENTRIES — Livre d'or (V2)
// ═══════════════════════════════════════════════════════════════════════════════

model GuestbookEntry {
  id        String   @id @default(cuid())
  qrCodeId  String   @map("qr_code_id")
  guestName String   @map("guest_name")
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  qrCode QrCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId])
  @@index([createdAt])
  @@map("guestbook_entries")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 14 : PUSH_SUBSCRIPTIONS — Abonnements Push PWA (V2)
// ═══════════════════════════════════════════════════════════════════════════════

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  homeId    String?  @map("home_id")  // V3: optionnel, pour filtrer par maison
  endpoint  String
  p256dhKey String   @map("p256dh_key")
  authKey   String   @map("auth_key")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 15 : NOTIFICATIONS — Notifications in-app (V2)
// ═══════════════════════════════════════════════════════════════════════════════

model Notification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  homeId      String?  @map("home_id")     // V3: nullable (notifications pro sans home)
  type        String
  title       String
  body        String?
  dataJson    String?  @map("data_json")
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  home Home? @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// █████████████████████████████████████████████████████████████████████████████████
// ██  V3 — MODULE A : MON QUARTIER CONNECTÉ (Commerçants & Promos)             ██
// █████████████████████████████████████████████████████████████████████████████████

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 16 : MERCHANTS — Commerçants locaux
// ═══════════════════════════════════════════════════════════════════════════════
// Inscription gratuite, abonnement premium/featured payant.
// Geo: latitude/longitude pour affichage carte Leaflet + calcul distance.
// openingHoursJson: JSON string → { "monday": "9h-19h", ... }

model Merchant {
  id                    String    @id @default(cuid())
  userId                String?   @unique @map("user_id")    // Nullable: le commerçant peut ne pas avoir de compte
  name                  String
  category              String                             // 'boulangerie','boucherie','pharmacie','epicerie','fleuriste'...
  description           String?
  address               String?
  latitude              Float                              // PostGIS → lat/lng + Haversine
  longitude             Float
  phone                 String?
  website               String?   @map("website")
  openingHoursJson      String?   @map("opening_hours_json")  // JSON: {"monday":"9h-19h",...}
  logoUrl               String?   @map("logo_url")
  subscriptionTier      String    @default("free") @map("subscription_tier") // 'free'|'premium'|'featured'
  subscriptionExpiresAt DateTime? @map("subscription_expires_at")
  stripeCustomerId      String?   @map("stripe_customer_id")
  isVerified            Boolean   @default(false) @map("is_verified")
  ratingAvg             Float     @default(0) @map("rating_avg")
  totalReviews          Int       @default(0) @map("total_reviews")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // ─── Relations ───
  user    User?   @relation("MerchantUser", fields: [userId], references: [id], onDelete: SetNull)
  promos  Promo[]

  @@index([category])
  @@index([latitude])
  @@index([longitude])
  @@index([isActive])
  @@index([subscriptionTier])
  @@map("merchants")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 17 : PROMOS — Promotions locales ET scrapées
// ═══════════════════════════════════════════════════════════════════════════════
// source='local' → créée par un commerçant
// source='scraped' → récupérée par le script Playwright (Carrefour, Auchan...)
// keywordsJson: JSON array string → ["pain", "baguette", "viennoiserie"]

model Promo {
  id                    String    @id @default(cuid())
  merchantId            String?   @map("merchant_id")    // NULL si promo scrapée grande surface
  source                String    @default("local")      // 'local' | 'scraped'
  title                 String
  description           String?
  imageUrl              String?   @map("image_url")
  originalPrice         Float?    @map("original_price")
  promoPrice            Float     @map("promo_price")
  validFrom             DateTime? @map("valid_from")
  validUntil            DateTime  @map("valid_until")
  keywordsJson          String    @default("[]") @map("keywords_json") // JSON array
  category              String?                              // Pour filtrage par catégorie
  isFlashSale           Boolean   @default(false) @map("is_flash_sale")
  flashSaleTriggeredAt  DateTime? @map("flash_sale_triggered_at")
  flashSaleCost         Float?    @map("flash_sale_cost")        // 0.50 € payé par le commerçant
  viewsCount            Int       @default(0) @map("views_count")
  redemptionsCount      Int       @default(0) @map("redemptions_count")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // ─── Relations ───
  merchant   Merchant?          @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  redemptions PromoRedemption[]

  @@index([merchantId])
  @@index([source])
  @@index([validUntil])
  @@index([isFlashSale])
  @@index([category])
  @@index([keywordsJson])
  @@map("promos")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 18 : PROMO_REDEMPTIONS — Coupons utilisés
// ═══════════════════════════════════════════════════════════════════════════════

model PromoRedemption {
  id               String   @id @default(cuid())
  promoId          String   @map("promo_id")
  userId           String   @map("user_id")
  redeemedAt       DateTime @default(now()) @map("redeemed_at")
  commissionAmount Float    @default(0) @map("commission_amount")

  // ─── Relations ───
  promo Promo @relation(fields: [promoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([promoId])
  @@index([userId])
  @@index([redeemedAt])
  @@map("promo_redemptions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 19 : SCRAPING_JOBS — Logs des tâches de scraping
// ═══════════════════════════════════════════════════════════════════════════════

model ScrapingJob {
  id              String    @id @default(cuid())
  source          String                              // 'carrefour','auchan','leclerc'
  storeLocation   String    @map("store_location")
  status          String    @default("running")      // 'running'|'success'|'failed'
  productsScraped Int       @default(0) @map("products_scraped")
  errorMessage    String?   @map("error_message")
  startedAt       DateTime  @default(now()) @map("started_at")
  finishedAt      DateTime? @map("finished_at")

  @@index([source])
  @@index([status])
  @@index([startedAt])
  @@map("scraping_jobs")
}

// █████████████████████████████████████████████████████████████████████████████████
// ██  V3 — MODULE B : SERVICES À LA PERSONNE (Artisans & Prestataires)       ██
// █████████████████████████████████████████████████████████████████████████████████

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 20 : PROFESSIONALS — Artisans & prestataires
// ═══════════════════════════════════════════════════════════════════════════════
// 4 catégories: entretien, depannage, bien_etre, assistance
// verificationDocsJson: JSON string → [{"type":"kbis","url":"..."}, ...]
// portfolioImagesJson: JSON array string → ["url1","url2",...]

model Professional {
  id                       String    @id @default(cuid())
  userId                   String    @unique @map("user_id")  // Un pro a obligatoirement un compte
  businessName              String    @map("business_name")
  category                 String                              // 'plumber','electrician','locksmith','cleaner'...
  subcategory              String?   @map("subcategory")
  description              String?
  latitude                 Float
  longitude                Float
  serviceRadiusKm          Int       @default(10) @map("service_radius_km")
  hourlyRate               Float     @map("hourly_rate")
  isUrgentAvailable        Boolean   @default(false) @map("is_urgent_available")
  isVerified               Boolean   @default(false) @map("is_verified")
  verificationDocsJson     String    @default("[]") @map("verification_docs_json")
  portfolioImagesJson      String    @default("[]") @map("portfolio_images_json")
  subscriptionStatus       String    @default("free") @map("subscription_status") // 'free'|'premium'|'featured'
  subscriptionExpiresAt    DateTime? @map("subscription_expires_at")
  stripeCustomerId         String?   @map("stripe_customer_id")
  ratingAvg                Float     @default(0) @map("rating_avg")
  totalReviews             Int       @default(0) @map("total_reviews")
  responseTimeMinutes      Int?      @map("response_time_minutes")
  totalJobsCompleted       Int       @default(0) @map("total_jobs_completed")
  isActive                 Boolean   @default(true) @map("is_active")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  // ─── Relations ───
  user        User            @relation("ProfessionalUser", fields: [userId], references: [id], onDelete: Cascade)
  services    Service[]
  reviews     Review[]
  requests    ServiceRequest[]
  subscriptions Subscription[]

  @@index([category])
  @@index([latitude])
  @@index([longitude])
  @@index([isActive])
  @@index([isVerified])
  @@index([isUrgentAvailable])
  @@map("professionals")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 21 : SERVICES — Services proposés par un pro
// ═══════════════════════════════════════════════════════════════════════════════

model Service {
  id               String   @id @default(cuid())
  professionalId   String   @map("professional_id")
  name             String
  description      String?
  basePrice        Float    @map("base_price")
  priceUnit        String   @default("hour") @map("price_unit") // 'hour'|'flat_rate'|'estimate'
  durationMinutes  Int?     @map("duration_minutes")
  isUrgent         Boolean  @default(false) @map("is_urgent")
  isActive         Boolean  @default(true) @map("is_active")

  // ─── Relations ───
  professional  Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]

  @@index([professionalId])
  @@index([isActive])
  @@map("services")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 22 : SERVICE_REQUESTS — Demandes de réservation
// ═════════════════════════════════════════════════════════════════════════════════
// photosJson: JSON array string → ["url1","url2",...]

model ServiceRequest {
  id               String    @id @default(cuid())
  homeId           String    @map("home_id")
  professionalId    String    @map("professional_id")
  serviceId        String?   @map("service_id")
  qrCodeId         String?   @map("qr_code_id")         // Si déclenché par QR urgence
  status           String    @default("pending")         // 'pending'|'accepted'|'in_progress'|'completed'|'cancelled'|'disputed'
  description      String?
  photosJson       String    @default("[]") @map("photos_json")
  preferredDate    DateTime? @map("preferred_date")
  urgencyLevel     String    @default("normal") @map("urgency_level") // 'normal'|'urgent'|'emergency'
  address          String?
  finalPrice       Float?    @map("final_price")
  commissionAmount Float?    @map("commission_amount")
  paidAt           DateTime? @map("paid_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // ─── Relations ───
  home         Home          @relation(fields: [homeId], references: [id], onDelete: Cascade)
  professional Professional   @relation(fields: [professionalId], references: [id])
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  qrCode       QrCode?       @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  review       Review?

  @@index([homeId])
  @@index([professionalId])
  @@index([serviceId])
  @@index([status])
  @@index([urgencyLevel])
  @@index([createdAt])
  @@map("service_requests")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 23 : REVIEWS — Avis après intervention
// ═══════════════════════════════════════════════════════════════════════════════
// Application-level validation: rating must be 1-5.

model Review {
  id               String   @id @default(cuid())
  serviceRequestId String   @unique @map("service_request_id")
  professionalId   String   @map("professional_id")
  userId           String   @map("user_id")
  rating           Int                                  // 1-5, validé applicativement
  comment          String?
  createdAt        DateTime @default(now()) @map("created_at")

  // ─── Relations ───
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  professional   Professional   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@index([userId])
  @@index([rating])
  @@map("reviews")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 24 : EMERGENCY_QR_CODES — Configuration QR codes d'urgence
// ═════════════════════════════════════════════════════════════════════════════
// Un QR code de type 'emergency_service' est lié à cette config.
// equipmentInfoJson: JSON → {"boiler_model":"Chaffoteau 2019", ...}

model EmergencyQrCode {
  id               String   @id @default(cuid())
  qrCodeId         String   @unique @map("qr_code_id")
  emergencyCategory String   @map("emergency_category") // 'plumber'|'electrician'|'locksmith'|'heating'
  equipmentInfoJson String  @default("{}") @map("equipment_info_json")
  isActive         Boolean  @default(true) @map("is_active")

  // ─── Relations ───
  qrCode QrCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([emergencyCategory])
  @@index([isActive])
  @@map("emergency_qr_codes")
}

// █████████████████████████████████████████████████████████████████████████████████
// ██  V3 — MONÉTISATION UNIFIÉE                                             ██
// █████████████████████████████████████████████████████████████████████████████████

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 25 : SUBSCRIPTIONS — Abonnements pros/commerçants
// ═══════════════════════════════════════════════════════════════════════════════

model Subscription {
  id                   String   @id @default(cuid())
  subscriberId         String   @map("subscriber_id")
  subscriberType       String   @map("subscriber_type") // 'merchant' | 'professional'
  plan                 String                             // 'premium' | 'featured'
  amount               Float
  currency             String   @default("EUR")
  stripeSubscriptionId String?  @map("stripe_subscription_id")
  status               String   @default("active")     // 'active'|'cancelled'|'past_due'
  currentPeriodStart   DateTime @map("current_period_start")
  currentPeriodEnd     DateTime @map("current_period_end")
  createdAt            DateTime @default(now()) @map("created_at")

  // ─── Relations ───
  professional Professional? @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([subscriberId])
  @@index([subscriberType])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 26 : TRANSACTIONS — Micro-paiements et commissions
// ═══════════════════════════════════════════════════════════════════════════════

model Transaction {
  id                String   @id @default(cuid())
  type              String                             // 'flash_sale'|'commission'|'subscription'|'redemption'
  payerId           String?  @map("payer_id")
  receiverId        String?  @map("receiver_id")       // Pro/commerçant OU QR Domotik
  amount            Float
  currency          String   @default("EUR")
  stripePaymentId   String?  @map("stripe_payment_id")
  status            String   @default("pending")      // 'pending'|'completed'|'failed'|'refunded'
  referenceId       String?  @map("reference_id")      // ID promo, service_request, etc.
  createdAt         DateTime @default(now()) @map("created_at")

  // ─── Relations ───
  payer    User? @relation("TransactionPayer", fields: [payerId], references: [id], onDelete: SetNull)
  receiver User? @relation("TransactionReceiver", fields: [receiverId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([payerId])
  @@index([receiverId])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

// █████████████████████████████████████████████████████████████████████████████████
// ██  V4 — QR CODES PHYSIQUES & ACTIVATION                           ██
// █████████████████████████████████████████████████████████████████████████████████

// ═══════════════════════════════════════════════════════════════════
// TABLE 27 : QR_BATCHES — Lots générés par le Superadmin
// ═══════════════════════════════════════════════════════════════════
// Un lot contient N QR codes physiques avec un design unique.
// designConfigJson stocke : {"color":"#2563EB","logoUrl":"/logos/wifi.png","dotStyle":"rounded"}

model QrBatch {
  id               String   @id @default(cuid())
  quantity         Int                                // 10, 15, ou 20
  designConfigJson String   @default("{}") @map("design_config_json")
  createdBy        String   @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  // ─── Relations ───
  creator    User             @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  qrCodes    PhysicalQrCode[]

  @@index([createdBy])
  @@index([createdAt])
  @@map("qr_batches")
}

// ═════════════════════════════════════════════════════════════════════
// TABLE 28 : PHYSICAL_QR_CODES — QR codes individuels physiques
// ═══════════════════════════════════════════════════════════════════
// Chaque QR physique a un code d'activation unique (ex: QR-A7K9M2P3).
// Le QR physique pointe vers /activate/[activation_code].
// Une fois activé, il est lié à un QrCode dynamique.

model PhysicalQrCode {
  id                  String    @id @default(cuid())
  batchId             String    @map("batch_id")
  activationCode      String    @unique @map("activation_code") // ex: "QR-A7K9M2P3"
  status              String    @default("inactive")             // 'inactive'|'active'|'lost'|'cancelled'
  activatedByUserId   String?   @map("activated_by_user_id")
  activatedAt         DateTime? @map("activated_at")
  dynamicQrCodeId     String?   @unique @map("dynamic_qr_code_id")
  designConfigJson    String    @default("{}") @map("design_config_json") // hérité du batch

  // ─── Relations ───
  batch             QrBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  activatedBy        User?    @relation("Activator", fields: [activatedByUserId], references: [id], onDelete: SetNull)
  dynamicQrCode      QrCode?  @relation("LinkedQrCode", fields: [dynamicQrCodeId], references: [id], onDelete: SetNull)
  activationLogs     ActivationLog[]

  @@index([batchId])
  @@index([activationCode])
  @@index([status])
  @@index([activatedByUserId])
  @@map("physical_qr_codes")
}

// ═════════════════════════════════════════════════════════════════════
// TABLE 29 : ACTIVATION_LOGS — Historique d'audit
// ═══════════════════════════════════════════════════════════════════
// Journalise chaque action sur un QR code physique.

model ActivationLog {
  id                 String   @id @default(cuid())
  physicalQrCodeId   String   @map("physical_qr_code_id")
  userId             String?  @map("user_id")
  action             String                                     // 'activated'|'deactivated'|'marked_lost'|'cancelled'
  details            String?  @default("{}")  @map("details") // JSON: info additionnelle
  createdAt          DateTime @default(now()) @map("created_at")

  // ─── Relations ───
  physicalQrCode   PhysicalQrCode @relation(fields: [physicalQrCodeId], references: [id], onDelete: Cascade)
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([physicalQrCodeId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activation_logs")
}