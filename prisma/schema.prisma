// ═══════════════════════════════════════════════════════════════════════════════
// QR DOMOTIK V2 — Schéma de Base de Données Complet
// Plateforme SaaS de Maison Phygital via QR Codes Dynamiques
// ═══════════════════════════════════════════════════════════════════════════════
//
// STACK : SQLite + Prisma ORM (adapté depuis spec Supabase/PostgreSQL)
// RLS   : Émulé au niveau applicatif via checkMembership() sur chaque API
// IDs   : CUID (String) au lieu d'UUID natif PostgreSQL
//
// TABLES V1 (9) : User, Home, HomeMember, Room, QrCode, QrContent,
//                  ActivityLog, Product, ProductInstance
// TABLES V2 (6) : Chore, ChoreCompletion, Invitation, GuestbookEntry,
//                  PushSubscription, Notification
//
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Configuration ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 1 : USERS — Utilisateurs de la plateforme
// ═══════════════════════════════════════════════════════════════════════════════
// Un utilisateur peut être propriétaire de plusieurs maisons,
// et membre de maisons d'autres propriétaires.
// V2: Ajout du champ `avatarColor` pour les avatars générés.

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  passwordHash String  @map("password_hash")
  fullName    String   @map("full_name")
  avatarUrl   String?  @map("avatar_url")
  avatarColor String?  @map("avatar_color") // Couleur hex ex: "#8B5CF6"
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // ─── Relations ───
  ownedHomes         Home[]              @relation("HomeOwner")
  memberships        HomeMember[]
  activityLogs       ActivityLog[]
  choreCompletions   ChoreCompletion[]   @relation("ChildCompletions")
  validatedChores    ChoreCompletion[]   @relation("ValidatorCompletions")
  assignedChores     Chore[]             @relation("ChoreAssignee")
  sentInvitations    Invitation[]        @relation("Inviter")
  pushSubscriptions  PushSubscription[]
  notifications      Notification[]

  @@map("users")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 2 : HOMES — Maisons / Foyers
// ═══════════════════════════════════════════════════════════════════════════════
// Chaque maison appartient à un propriétaire (User).
// Une maison contient des pièces, des QR codes, des produits, des corvées, etc.

model Home {
  id        String   @id @default(cuid())
  ownerId   String   @map("owner_id")
  name      String
  address   String?
  timezone  String   @default("Europe/Paris")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ─── Relations ───
  owner         User              @relation("HomeOwner", fields: [ownerId], references: [id])
  members       HomeMember[]
  rooms         Room[]
  qrCodes       QrCode[]
  activityLogs  ActivityLog[]
  products      Product[]
  chores        Chore[]
  invitations       Invitation[]
  notifications      Notification[]

  @@map("homes")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 3 : HOME_MEMBERS — Membres d'un foyer (V2 ENHANCED)
// ═══════════════════════════════════════════════════════════════════════════════
// Rôles : owner, admin, member, child
// V2: Ajout de nickname ("Papa", "Léa"), points (gamification enfants),
//     invitedAt/joinedAt (parcours invitation).
// RLS: Émulé au niveau applicatif — chaque API vérifie le rôle du membre.

model HomeMember {
  id        String    @id @default(cuid())
  homeId    String    @map("home_id")
  userId    String    @map("user_id")
  role      String    @default("member") // 'owner' | 'admin' | 'member' | 'child'
  nickname  String?                          // Ex: "Papa", "Maman", "Léa", "Tom"
  points    Int       @default(0)            // Points de gamification (enfant)
  invitedAt DateTime? @map("invited_at")     // Date d'envoi de l'invitation
  joinedAt  DateTime? @map("joined_at")      // Date d'acceptation de l'invitation
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // ─── Relations ───
  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ─── Contraintes ───
  @@unique([homeId, userId]) // Un utilisateur ne peut être membre qu'une fois par maison
  @@index([homeId])
  @@index([userId])
  @@map("home_members")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 4 : ROOMS — Pièces de la maison
// ═══════════════════════════════════════════════════════════════════════════════
// Exemples : Cuisine, Salon, Chambre, Entrée, Garage, Salle de bain
// Le champ `icon` stocke le nom d'une icône Lucide (ex: "utensils", "sofa")

model Room {
  id        String   @id @default(cuid())
  homeId    String   @map("home_id")
  name      String
  icon      String   @default("square")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ─── Relations ───
  home    Home      @relation(fields: [homeId], references: [id], onDelete: Cascade)
  qrCodes QrCode[]

  @@index([homeId])
  @@map("rooms")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 5 : QR_CODES — Codes QR dynamiques (V2 ENHANCED)
// ═══════════════════════════════════════════════════════════════════════════════
// Le `public_slug` est l'identifiant public unique (ex: 'x8k2p9').
// Le `type` détermine quel module renderer utiliser.
// Le `pinCode` optionnel protège l'accès aux modules sensibles (Portier).
// Le `isPresentMode` est spécifique au module Portier (Absent/Présent).
// V2: Ajout de `isPrivate` (flag explicite pour la protection PIN).
// V2: Ajout du type `guestbook` (livre d'or).

model QrCode {
  id            String   @id @default(cuid())
  homeId        String   @map("home_id")
  roomId        String?  @map("room_id")
  name          String
  type          String   // Voir QrType dans types/index.ts
  publicSlug    String   @unique @map("public_slug")
  isActive      Boolean  @default(true) @map("is_active")
  isPrivate     Boolean  @default(false) @map("is_private") // V2: flag PIN requis
  pinCode       String?  @map("pin_code") // PIN 4 chiffres optionnel
  isPresentMode Boolean  @default(true) @map("is_present_mode") // Portier: true=Présent
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // ─── Relations ───
  home            Home            @relation(fields: [homeId], references: [id], onDelete: Cascade)
  room            Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  content         QrContent?
  activityLogs    ActivityLog[]
  guestbookEntries GuestbookEntry[]

  @@index([homeId])
  @@index([publicSlug])
  @@index([type])
  @@map("qr_codes")
}

/*
  ┌──────────────────────────────────────────────────────────────────┐
  │  TYPES DE QR CODES (QrType) — V2                                │
  ├──────────────────────────────────────────────────────────────────┤
  │  V1:                                                            │
  │  "wifi"          → Connexion Wi-Fi                              │
  │  "link"          → Lien externe (Spotify, PDF, etc.)            │
  │  "info"          → Page d'information / Guide maison            │
  │  "postit"        → Post-it numérique                            │
  │  "shopping_list" → Liste de courses / Tâches collaborative      │
  │  "doorman"       → Portier virtuel (livreurs, voisins)          │
  │  "medication"    → Suivi médicaments / Vitamines                │
  │  "chores"        → Corvées enfants (gamifié avec points)        │
  │  "stock_dlc"     → Gestion stock & Dates Limites Consommation   │
  │                                                                  │
  │  V2 (ajouts):                                                    │
  │  "guestbook"      → Livre d'or (messages des visiteurs)        │
  │  "energy_counter" → Compteur d'énergie (consommation)           │
  │  "keys_tracker"   → Suivi des clés & objets                     │
  │  "daily_menu"     → Menu du jour                                │
  └──────────────────────────────────────────────────────────────────┘
*/

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 6 : QR_CONTENTS — Contenu dynamique de chaque QR code
// ═══════════════════════════════════════════════════════════════════════════════
// Le `contentJson` stocke la configuration spécifique au type de module.
// Exemples dans src/types/index.ts — interfaces par type.

model QrContent {
  id          String   @id @default(cuid())
  qrCodeId    String   @unique @map("qr_code_id")
  contentJson String   @map("content_json") // JSON string
  updatedAt   DateTime @updatedAt @map("updated_at")

  // ─── Relations ───
  qrCode QrCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@map("qr_contents")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 7 : ACTIVITY_LOGS — Journal d'activité global (V2 ENHANCED)
// ═══════════════════════════════════════════════════════════════════════════════
// Enregistre TOUTES les interactions : portier, médicaments, stock, corvées, etc.
// `userId` est nullable car les visiteurs (livreurs, invités) ne sont pas connectés.
// V2: actionType enrichi avec plus de types (voir types/index.ts).

model ActivityLog {
  id          String   @id @default(cuid())
  homeId      String   @map("home_id")
  qrCodeId    String?  @map("qr_code_id")
  userId      String?  @map("user_id")
  actionType  String   @map("action_type")
  detailsJson String?  @map("details_json")
  visitorName String?  @map("visitor_name")
  createdAt   DateTime @default(now()) @map("created_at")

  // ─── Relations ───
  home    Home    @relation(fields: [homeId], references: [id], onDelete: Cascade)
  qrCode  QrCode? @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([homeId])
  @@index([qrCodeId])
  @@index([userId])
  @@index([actionType])
  @@index([createdAt])
  @@map("activity_logs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 8 : PRODUCTS — Produits pour le module Stock & DLC (V2 ENHANCED)
// ═══════════════════════════════════════════════════════════════════════════════
// Représente un type de produit (ex: "Lait", "Yaourt")
// V2: Ajout de `isOnShoppingList` pour bascule automatique vers liste de courses.

model Product {
  id                 String   @id @default(cuid())
  homeId             String   @map("home_id")
  name               String
  category           String   @default("autre")
  minStockThreshold  Int      @default(1) @map("min_stock_threshold")
  currentStock       Int      @default(0) @map("current_stock")
  isOnShoppingList   Boolean  @default(false) @map("is_on_shopping_list") // V2
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // ─── Relations ───
  home             Home              @relation(fields: [homeId], references: [id], onDelete: Cascade)
  productInstances ProductInstance[]

  @@index([homeId])
  @@map("products")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 9 : PRODUCT_INSTANCES — Instances de produits (V2 ENHANCED)
// ═══════════════════════════════════════════════════════════════════════════════
// Chaque instance représente un article physique avec sa date de péremption.
// Le cron job quotidien met à jour le `status` en fonction de `expiryDate`.
// V2: Ajout de `homeId` pour les requêtes directes par maison.

model ProductInstance {
  id           String    @id @default(cuid())
  productId    String    @map("product_id")
  homeId       String    @map("home_id") // V2: accès direct par maison
  purchaseDate DateTime? @map("purchase_date")
  expiryDate   DateTime  @map("expiry_date")
  status       String    @default("fresh") // 'fresh'|'warning'|'critical'|'expired'|'consumed'
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // ─── Relations ───
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([homeId])
  @@index([expiryDate])
  @@index([status])
  @@map("product_instances")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 10 : CHORES — Corvées enfants (V2 NOUVEAU)
// ═══════════════════════════════════════════════════════════════════════════════
// Corvées avec système de points, fréquence, et attribution aux enfants.
// La validation se fait via ChoreCompletion.

model Chore {
  id                String   @id @default(cuid())
  homeId            String   @map("home_id")
  title             String
  description       String?
  pointsValue       Int      @default(10) @map("points_value")
  frequency         String   @default("once") // 'daily'|'weekly'|'once'
  assignedToUserId  String?  @map("assigned_to_user_id") // L'enfant assigné
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // ─── Relations ───
  home              Home              @relation(fields: [homeId], references: [id], onDelete: Cascade)
  assignedToUser    User?             @relation("ChoreAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  completions       ChoreCompletion[]

  @@index([homeId])
  @@index([assignedToUserId])
  @@map("chores")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 11 : CHORE_COMPLETIONS — Validations de corvées (V2 NOUVEAU)
// ═══════════════════════════════════════════════════════════════════════════════
// Quand un enfant coche "Fait", un enregistrement est créé en 'pending_validation'.
// Le parent valide → points ajoutés au compteur HomeMember.points.

model ChoreCompletion {
  id               String    @id @default(cuid())
  choreId          String    @map("chore_id")
  childUserId      String    @map("child_user_id")
  validatedByUserId String?  @map("validated_by_user_id")
  pointsEarned     Int       @default(0) @map("points_earned")
  completedAt      DateTime  @default(now()) @map("completed_at")
  validatedAt      DateTime? @map("validated_at")
  status           String    @default("pending_validation") // 'pending_validation'|'validated'|'rejected'
  createdAt        DateTime  @default(now()) @map("created_at")

  // ─── Relations ───
  chore          Chore            @relation(fields: [choreId], references: [id], onDelete: Cascade)
  childUser      User             @relation("ChildCompletions", fields: [childUserId], references: [id], onDelete: Cascade)
  validatedByUser User?           @relation("ValidatorCompletions", fields: [validatedByUserId], references: [id], onDelete: SetNull)

  @@index([choreId])
  @@index([childUserId])
  @@index([status])
  @@map("chore_completions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 12 : INVITATIONS — Invitations de membres (V2 NOUVEAU)
// ═══════════════════════════════════════════════════════════════════════════════
// Un propriétaire/admin invite un membre par email.
// Le token unique permet l'acceptation sans auth préalable.
// Le token expire après 7 jours.

model Invitation {
  id         String   @id @default(cuid())
  homeId     String   @map("home_id")
  inviterId  String   @map("inviter_id")
  email      String
  role       String   @default("member") // 'admin'|'member'|'child'
  token      String   @unique             // Token d'acceptation (32 chars hex)
  status     String   @default("pending") // 'pending'|'accepted'|'expired'|'revoked'
  nickname   String?                      // Suggestion de nickname
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  // ─── Relations ───
  home    Home   @relation(fields: [homeId], references: [id], onDelete: Cascade)
  inviter User   @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([homeId])
  @@index([email])
  @@index([token])
  @@index([status])
  @@map("invitations")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 13 : GUESTBOOK_ENTRIES — Livre d'or (V2 NOUVEAU)
// ═══════════════════════════════════════════════════════════════════════════════
// Messages laissés par les visiteurs via un QR code de type 'guestbook'.

model GuestbookEntry {
  id        String   @id @default(cuid())
  qrCodeId  String   @map("qr_code_id")
  guestName String   @map("guest_name")
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  // ─── Relations ───
  qrCode QrCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId])
  @@index([createdAt])
  @@map("guestbook_entries")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 14 : PUSH_SUBSCRIPTIONS — Abonnements Push PWA (V2 NOUVEAU)
// ═══════════════════════════════════════════════════════════════════════════════
// Stocke les endpoints Web Push pour envoyer des notifications
// aux utilisateurs via leur navigateur (PWA installée).
// Un utilisateur peut avoir plusieurs abonnements (mobile + desktop).

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   // URL unique du service push
  p256dhKey String   @map("p256dh_key") // Clé de chiffrement
  authKey   String   @map("auth_key")   // Clé d'authentification
  createdAt DateTime @default(now()) @map("created_at")

  // ─── Relations ───
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// TABLE 15 : NOTIFICATIONS — Notifications in-app (V2 NOUVEAU)
// ═══════════════════════════════════════════════════════════════════════════════
// Historique des notifications envoyées (push + in-app).
// Permet de relire les notifications même si le push a été manqué.

model Notification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  homeId      String   @map("home_id")
  type        String   // 'dlc_warning'|'stock_alert'|'visitor_message'|'chore_validation'|'porter_ring'
  title       String
  body        String?
  dataJson    String?  @map("data_json") // Données additionnelles (JSON)
 isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  // ─── Relations ───
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([homeId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}
